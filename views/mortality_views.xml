<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chicken_mortality_list" model="ir.ui.view">
        <field name="name">chicken.mortality.list</field>
        <field name="model">chicken.mortality</field>
        <field name="arch" type="xml">
            <list string="Chicken Mortality" editable="bottom">
                <field name="date"/>
                <field name="batch_id"/>
                <field name="chicken_type"/>
                <field name="chicken_category"/>
                <field name="total_dead"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_chicken_mortality_form" model="ir.ui.view">
        <field name="name">chicken.mortality.form</field>
        <field name="model">chicken.mortality</field>
        <field name="arch" type="xml">
            <form string="Chicken Mortality">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="batch_id"/>
                        <field name="chicken_type"/>
                        <field name="chicken_category"/>
                        <field name="total_dead"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chicken_mortality_search" model="ir.ui.view">
        <field name="name">chicken.mortality.search</field>
        <field name="model">chicken.mortality</field>
        <field name="arch" type="xml">
            <search string="Search Mortality">
                <field name="batch_id"/>
                <group expand="0" string="Group By">
                    <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chicken_mortality" model="ir.actions.act_window">
        <field name="name">Chicken Mortality</field>
        <field name="res_model">chicken.mortality</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chicken_mortality_search"/>
    </record>

</odoo>
