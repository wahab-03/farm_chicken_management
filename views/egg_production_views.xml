<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_egg_production_list" model="ir.ui.view">
        <field name="name">egg.production.list</field>
        <field name="model">egg.production</field>
        <field name="arch" type="xml">
            <list string="Daily Egg Production" editable="bottom">
                <field name="date"/>
                <field name="batch_id"/>
                <field name="chicken_type"/>
                <field name="quantity"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_egg_production_form" model="ir.ui.view">
        <field name="name">egg.production.form</field>
        <field name="model">egg.production</field>
        <field name="arch" type="xml">
            <form string="Egg Production">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="batch_id"/>
                        <field name="chicken_type"/>
                        <field name="quantity"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_egg_production_search" model="ir.ui.view">
        <field name="name">egg.production.search</field>
        <field name="model">egg.production</field>
        <field name="arch" type="xml">
            <search string="Search Egg Production">
                <field name="batch_id"/>
                <group expand="0" string="Group By">
                    <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_egg_production" model="ir.actions.act_window">
        <field name="name">Daily Egg Production</field>
        <field name="res_model">egg.production</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_egg_production_search"/>
    </record>

</odoo>
