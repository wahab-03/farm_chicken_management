<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_chicken_batch" model="ir.sequence">
            <field name="name">Chicken Batch</field>
            <field name="code">chicken.batch</field>
            <field name="prefix">Batch </field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_chicken_sale" model="ir.sequence">
            <field name="name">Chicken Sale</field>
            <field name="code">chicken.sale</field>
            <field name="prefix">SALE/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_feed_mixing" model="ir.sequence">
            <field name="name">Feed Mixing</field>
            <field name="code">feed.mixing</field>
            <field name="prefix">MIX/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_incubator_hatching_batch" model="ir.sequence">
            <field name="name">Hatching Batch</field>
            <field name="code">incubator.hatching.batch</field>
            <field name="prefix">HATCH/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_baby_chicken_stock" model="ir.sequence">
            <field name="name">Baby Chicken Stock</field>
            <field name="code">baby.chicken.stock</field>
            <field name="prefix">BABY/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_baby_chicken_sale" model="ir.sequence">
            <field name="name">Baby Chick Sale</field>
            <field name="code">baby.chicken.sale</field>
            <field name="prefix">BABY-SALE/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
